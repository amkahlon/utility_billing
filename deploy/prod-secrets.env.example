# Production settings for the prod-*.sh scripts (increment 23).
# Copy to /etc/ums/secrets.env on the server, fill in, then: chown root:root /etc/ums/secrets.env && chmod 600 /etc/ums/secrets.env
# NEVER put the filled-in file in this folder, in git or in chat. Keep a copy in the client's password manager.

# --- the site
DOMAIN=billing.example.com            # the public name; its DNS A record must point at this server before prod-2-https.sh
SITE_ADMIN_PASSWORD=CHANGE-ME          # Frappe Administrator password for the site
MARIADB_ROOT_PASSWORD=CHANGE-ME
APP_REPO=git@github.com:amkahlon/utility_billing.git   # needs the server's deploy key added on GitHub (read-only)
APP_BRANCH=main
FRAPPE_BRANCH=version-16

# --- e-mail (outgoing; for notices, alerts and password resets)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=billing@example.com
SMTP_PASSWORD=CHANGE-ME
SMTP_FROM="Utility Billing <billing@example.com>"
ALERT_EMAIL=it@example.com             # who gets backup, disk and downtime alerts

# --- backups to S3-compatible storage (user decision 2026-11-16): AWS S3, Backblaze B2, Wasabi, DigitalOcean Spaces …
S3_PROVIDER=AWS                        # rclone provider name: AWS, Wasabi, DigitalOcean, Other …
S3_ENDPOINT=                           # empty for AWS; e.g. s3.eu-central-1.wasabisys.com
S3_REGION=me-central-1
S3_BUCKET=ums-backups-example
S3_ACCESS_KEY_ID=CHANGE-ME             # a key allowed to read and write this bucket only
S3_SECRET_ACCESS_KEY=CHANGE-ME
BACKUP_PASSPHRASE=CHANGE-ME            # encrypts every backup (gpg AES-256). Lose it and the backups can't be read: keep it offline too
KEEP_DAILY=30
KEEP_MONTHLY=12
